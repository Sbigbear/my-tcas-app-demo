# 📌 Database connection string (MySQL / TiDB Cloud)
DATABASE_URL="mysql://root:password@localhost:3306/my_tcas_db"

# 📌 Authentication Secrets
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# 📌 API / App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# External APIs (ระบบภายนอก — ดูโปรเจกต์ tcas-external-api)
SCHOOL_API_URL="http://localhost:4000/api/school/students"
SCHOOL_API_KEY="school-demo-key"
TCAS_API_URL="http://localhost:4000/api/tcas/scores"
TCAS_API_KEY="tcas-demo-key"

#  ส่งอีเมลจริง (Gmail SMTP)
# 1) เปิด 2-Step Verification ใน Google Account
# 2) ไปที่ https://myaccount.google.com/apppasswords สร้าง App Password (ได้รหัส 16 ตัว)
# 3) ใส่อีเมล Gmail กับ App Password ด้านล่าง (ห้ามใช้รหัสผ่าน Gmail ปกติ)
# ถ้าเว้นว่างไว้ ระบบจะพิมพ์อีเมล/ลิงก์ออกทาง terminal ของ npm run dev แทนการส่งจริง
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

#  อีเมล Admin ตั้งต้นตอนรัน seed (ใช้อีเมลจริง เช่น yourname+admin@gmail.com)
SEED_ADMIN_EMAIL=""
